# --- Supabase (Settings -> API in your Supabase project dashboard) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin login for /admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Any long random string — used to sign the admin login cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-this-to-a-random-string

# --- Public info shown to tenants on the unlock card ---
# (No NEXT_PUBLIC_ prefix needed — AGENCY.phone in data/properties.js
#  already handles this, but you can wire these in later if you prefer
#  env-based config instead of editing the file directly.)
